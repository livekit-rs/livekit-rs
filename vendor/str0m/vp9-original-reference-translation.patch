+#[cfg(test)]
+mod original_reference_translation_tests {
+    use super::*;
+    fn hint(source: u16, keyframe: bool, refs: [u8; 3]) -> crate::media::Vp9Forwarding {
+        crate::media::Vp9Forwarding {
+            source_picture_id: source,
+            picture_bits: 15,
+            flexible: [true; 3],
+            predicted: [!keyframe; 3],
+            reference_diffs: [refs; 3],
+            ends: [Some(2), None, None],
+            temporal: 0,
+            switching_up: [false; 3],
+            dependent: [false; 3],
+            target_spatial: 0,
+            complete: true,
+            keyframe,
+        }
+    }
+    #[test]
+    fn original_flexible_references_translate_across_compacted_temporal_pictures() {
+        let mut p = Vp9Packetizer::default();
+        let first = p
+            .packetize_forwarding(1200, &[0x80, 0], hint(1000, true, [0; 3]))
+            .unwrap();
+        let second = p
+            .packetize_forwarding(1200, &[0x84, 1], hint(1004, false, [4, 0, 0]))
+            .unwrap();
+        assert_eq!(first.len(), 1);
+        assert_eq!(second.len(), 1);
+        let mut dep = Vp9Depacketizer::default();
+        let mut body = Vec::new();
+        let mut extra = CodecExtra::None;
+        dep.depacketize(&second[0], &mut body, &mut extra).unwrap();
+        assert!(dep.f && dep.p && dep.i);
+        assert_eq!(
+            dep.pdiff,
+            [1, 0, 0],
+            "source difference4 must become outgoing difference1 after whole higher-temporal pictures were omitted"
+        );
+        assert_eq!(dep.tid, 0);
+        assert_eq!(body, [0x84, 1]);
+        let before = p.picture_id;
+        assert!(
+            p.packetize_forwarding(1200, &[0x84, 2], hint(1008, false, [1, 0, 0]))
+                .is_err(),
+            "an actually absent retained reference cannot be relabeled as successful decode input"
+        );
+        assert_eq!(p.picture_id, before);
+    }
+    #[test]
+    fn each_new_reference_descriptor_clears_old_reference_tail() {
+        let mut dep = Vp9Depacketizer::default();
+        let mut body = Vec::new();
+        let mut extra = CodecExtra::None;
+        dep.depacketize(&[0xfc, 0x80, 1, 0, 3, 4, 0x84], &mut body, &mut extra)
+            .unwrap();
+        assert_eq!(dep.pdiff, [1, 2, 0]);
+        dep.depacketize(&[0xfc, 0x80, 2, 0, 2, 0x84], &mut body, &mut extra)
+            .unwrap();
+        assert_eq!(
+            dep.pdiff,
+            [1, 0, 0],
+            "stale multi-reference tail cannot leak into next actual one-reference packet"
+        );
+    }
+}
