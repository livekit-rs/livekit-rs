+#[cfg(test)]
+mod forwarding_metadata_tests {
+    use super::*;
+    #[test]
+    fn real_component_packetizer_retains_sid_tid_dependency_and_nonfinal_marker() {
+        let mut packetizer = Vp9Packetizer::default();
+        let base = crate::media::Vp9Forwarding {
+            ends: [Some(2), Some(4), Some(6)],
+            temporal: 0,
+            switching_up: [false; 3],
+            dependent: [false, true, true],
+            target_spatial: 2,
+            complete: true,
+            keyframe: true,
+        };
+        let packets = packetizer
+            .packetize_forwarding(
+                1200,
+                &[0x80, 0, 0x81, 0, 0x82, 0, 0xc2, 2, 2, 2, 0xc2],
+                base,
+            )
+            .unwrap();
+        assert_eq!(packets.len(), 3);
+        let mut depacketizer = Vp9Depacketizer::default();
+        let mut body = Vec::new();
+        let mut extra = CodecExtra::None;
+        for (index, packet) in packets.iter().enumerate() {
+            depacketizer
+                .depacketize(packet, &mut body, &mut extra)
+                .unwrap();
+            assert_eq!(depacketizer.sid, index as u8);
+            assert_eq!(depacketizer.tid, 0);
+            assert_eq!(depacketizer.d, index > 0);
+            assert_eq!(packetizer.is_marker(packet, None, index == 2), index == 2);
+            assert_eq!(
+                &packet[1..3],
+                &packets[0][1..3],
+                "one real picture ID shared by original spatial components"
+            );
+        }
+        assert_eq!(body, [0x80, 0, 0x81, 0, 0x82, 0]);
+        assert!(matches!(extra,CodecExtra::Vp9(v)if v.layers_scheme==[Some(2),Some(4),Some(6)]));
+        let tl0 = packetizer.tl0picidx;
+        let partial = crate::media::Vp9Forwarding {
+            ends: [Some(2), Some(4), None],
+            temporal: 2,
+            keyframe: false,
+            complete: false,
+            ..base
+        };
+        let packets = packetizer
+            .packetize_forwarding(1200, &[0x84, 0xee, 0x85, 0xee, 0xc1, 2, 2, 0xc1], partial)
+            .unwrap();
+        assert_eq!(packets.len(), 2);
+        assert_eq!(
+            packetizer.tl0picidx, tl0,
+            "higher temporal packets cannot increment base temporal index"
+        );
+        for (index, packet) in packets.iter().enumerate() {
+            let mut dep = Vp9Depacketizer::default();
+            let mut body = Vec::new();
+            let mut extra = CodecExtra::None;
+            dep.depacketize(packet, &mut body, &mut extra).unwrap();
+            assert_eq!(dep.sid, index as u8);
+            assert_eq!(dep.tid, 2);
+            assert!(
+                !packetizer.is_marker(packet, None, index == 1),
+                "retained lower spatial components must not become a displayed completed target picture"
+            );
+            assert_eq!(body, vec![0x84 + index as u8, 0xee]);
+        }
+    }
+}
