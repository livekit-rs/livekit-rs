+#[derive(Clone, Copy, Debug)]
+pub struct Vp9Forwarding {
+    /// Original cumulative component ends in the retained coded body.
+    pub ends: [Option<usize>; 3],
+    /// Actual temporal ID of these original components.
+    pub temporal: u8,
+    /// Source U+B temporal-up flag per component, never inferred from FPS.
+    pub switching_up: [bool; 3],
+    /// Actual original inter-layer D flag for each spatial component.
+    pub dependent: [bool; 3],
+    /// Current receiver-selected spatial layer, not highest retained lower layer.
+    pub target_spatial: u8,
+    /// Whether this output includes the receiver's final selected layer.
+    pub complete: bool,
+    /// Original keyframe classification rather than a repacketizer guess.
+    pub keyframe: bool,
+}
