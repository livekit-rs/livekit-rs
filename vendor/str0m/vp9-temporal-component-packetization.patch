 impl Vp9Packetizer {
+    pub(crate) fn packetize_forwarding(
+        &mut self,
+        mtu: usize,
+        payload: &[u8],
+        hint: crate::media::Vp9Forwarding,
+    ) -> Result<Vec<Vec<u8>>, PacketError> {
+        if !self.initialized {
+            #[cfg(test)]
+            {
+                self.picture_id = self.initial_picture_id;
+            }
+            #[cfg(not(test))]
+            {
+                use str0m_proto::NonCryptographicRng;
+                self.picture_id = NonCryptographicRng::u16() & 0x7fff;
+            }
+            self.initialized = true;
+        }
+        self.forwarding_complete = Some(hint.complete);
+        if hint.temporal == 0 {
+            self.tl0picidx = self.tl0picidx.wrapping_add(1);
+        }
+        let mut result = Vec::new();
+        let mut previous = 0usize;
+        for (spatial, end) in hint.ends.into_iter().enumerate() {
+            let Some(end) = end else {
+                continue;
+            };
+            if end <= previous || end > payload.len() {
+                return Err(PacketError::ErrVP9CorruptedPacket);
+            }
+            let body = &payload[previous..end];
+            previous = end;
+            let headroom = 8usize;
+            let Some(capacity) = mtu.checked_sub(headroom).filter(|n| *n > 0) else {
+                return Ok(Vec::new());
+            };
+            let parts = body.chunks(capacity);
+            let count = parts.len();
+            for (index, part) in parts.enumerate() {
+                let first = index == 0;
+                let last = index + 1 == count;
+                let mut flags = 0xa0; // I,L, non-flexible F=0.
+                if !hint.keyframe {
+                    flags |= 0x40;
+                }
+                if first {
+                    flags |= 0x08;
+                }
+                if last {
+                    flags |= 0x04;
+                }
+                // SS is emitted once on a real keyframe and describes the
+                // selected output spatial topology, not a flattened SID0.
+                let structure = hint.keyframe && first && result.is_empty();
+                if structure {
+                    flags |= 0x02;
+                }
+                let mut packet = Vec::with_capacity(8 + part.len());
+                packet.push(flags);
+                packet.push((self.picture_id >> 8) as u8 | 0x80);
+                packet.push(self.picture_id as u8);
+                packet.push(
+                    (hint.temporal << 5)
+                        | (u8::from(hint.switching_up[spatial]) << 4)
+                        | ((spatial as u8) << 1)
+                        | u8::from(hint.dependent[spatial]),
+                );
+                packet.push(self.tl0picidx);
+                if structure {
+                    packet.push(hint.target_spatial << 5);
+                }
+                packet.extend_from_slice(part);
+                result.push(packet);
+            }
+        }
+        self.picture_id = self.picture_id.wrapping_add(1) & 0x7fff;
+        Ok(result)
+    }
