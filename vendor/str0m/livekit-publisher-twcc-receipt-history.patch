+
+impl PublisherReceiptHistory {
+    fn unwrap(&mut self, sequence: u16) -> u64 {
+        // Pion unwraps against the last arrival, including out-of-order and
+        // duplicate packets, and never returns a negative sequence number.
+        let unwrapped = self.last_sequence.map_or(u64::from(sequence), |last| {
+            let previous = last as u16;
+            let delta = u64::from(sequence.wrapping_sub(previous));
+            let newer = delta < 32768 || (delta == 32768 && sequence > previous);
+            let forward = last + delta;
+            if !newer && forward >= 65536 {
+                forward - 65536
+            } else {
+                forward
+            }
+        });
+        self.last_sequence = Some(unwrapped);
+        unwrapped
+    }
+}
