+    pub(crate) fn record_publisher_receipt(&mut self, sequence: u16, time: Instant) -> bool {
+        const WINDOW: Duration = Duration::from_millis(500);
+        const SEQUENCE_CAPACITY: u64 = 1 << 15;
+
+        let history = self.publisher_history.as_mut().expect("publisher history");
+        let sequence = history.unwrap(sequence);
+        let bounds = history.bounds.get_or_insert(sequence..sequence + 1);
+        if history.cursor.is_some_and(|cursor| cursor >= bounds.end) {
+            // Pion ages the contiguous prefix, including missing positions.
+            // A newer receipt in that prefix stops the time-based eviction.
+            let limit = sequence.min(bounds.end);
+            let old_count = self
+                .queue
+                .iter()
+                .take_while(|receipt| {
+                    *receipt.seq < limit && time.saturating_duration_since(receipt.time) >= WINDOW
+                })
+                .count();
+            self.queue.drain(..old_count);
+            if bounds.start < limit {
+                bounds.start = self.queue.front().map_or(limit, |r| (*r.seq).min(limit));
+            }
+        }
+
+        // Rewind first even if this is a duplicate, but only distinct packets
+        // advance the responder's trigger. Keep the first receive timestamp.
+        let cursor = history.cursor.get_or_insert(sequence);
+        *cursor = (*cursor).min(sequence);
+        let seq = sequence.into();
+        self.receive_window.record_seq(seq);
+        if self.queue.binary_search_by_key(&seq, |r| r.seq).is_ok() {
+            return false;
+        }
+
+        if sequence < bounds.start {
+            if bounds.end - sequence <= SEQUENCE_CAPACITY {
+                bounds.start = sequence;
+            }
+        } else if sequence >= bounds.end {
+            let end = sequence + 1;
+            bounds.start = if end - bounds.end >= SEQUENCE_CAPACITY {
+                sequence
+            } else {
+                bounds.start.max(end.saturating_sub(SEQUENCE_CAPACITY))
+            };
+            bounds.end = end;
+            let evicted = self.queue.partition_point(|r| *r.seq < bounds.start);
+            self.queue.drain(..evicted);
+        }
+        if bounds.contains(&sequence) {
+            let idx = self.queue.partition_point(|r| r.seq < seq);
+            self.queue.insert(idx, Receipt { seq, time });
+            self.time_start.get_or_insert(time);
+            if self.observations_enabled {
+                self.observations.received(time);
+            }
+        }
+        *cursor = (*cursor).max(bounds.start);
+        // Pion counts the new receipt even if it was too old for the map.
+        true
+    }
