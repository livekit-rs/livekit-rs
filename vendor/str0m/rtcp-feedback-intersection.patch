+    #[test]
+    fn rtcp_feedback_is_the_intersection_with_the_first_remote_description() {
+        use std::collections::HashSet;
+
+        // Pion mediaengine.go rtcpFeedbackIntersection: Chrome offers Opus with only
+        // transport-cc, so a local `nack` must not be negotiated for audio.
+        let opus = CodecSpec {
+            codec: Codec::Opus,
+            clock_rate: Frequency::FORTY_EIGHT_KHZ,
+            channels: Some(2),
+            format: FormatParams::default(),
+        };
+        let mut local = PayloadParams::new(Pt::new_with_value(111), None, opus);
+        local.fb_nack = true;
+        let mut remote = PayloadParams::new(Pt::new_with_value(111), None, opus);
+        remote.fb_nack = false;
+        let (mut claimed, mut unlocked) = ([false; 128], HashSet::new());
+        local.update_param(&[remote], &mut claimed, false, &mut unlocked);
+        assert!(
+            !local.fb_nack(),
+            "feedback the remote did not list is not negotiated"
+        );
+        assert!(local.fb_transport_cc(), "listed by both sides");
+
+        // Later descriptions do not re-enable it (pion negotiates once).
+        let mut later = PayloadParams::new(Pt::new_with_value(111), None, opus);
+        later.fb_nack = true;
+        let mut claimed = [false; 128];
+        local.update_param(&[later], &mut claimed, false, &mut unlocked);
+        assert!(!local.fb_nack());
+
+        // Video feedback both sides list survives; one the remote omits is dropped.
+        let vp8 = CodecSpec {
+            codec: Codec::Vp8,
+            clock_rate: Frequency::NINETY_KHZ,
+            channels: None,
+            format: FormatParams::default(),
+        };
+        let mut local = PayloadParams::new(Pt::new_with_value(96), None, vp8);
+        let mut remote = PayloadParams::new(Pt::new_with_value(96), None, vp8);
+        remote.fb_remb = false;
+        let (mut claimed, mut unlocked) = ([false; 128], HashSet::new());
+        local.update_param(&[remote], &mut claimed, false, &mut unlocked);
+        assert!(local.fb_nack() && local.fb_pli() && local.fb_fir());
+        assert!(!local.fb_remb());
+    }
