     #[test]
+    fn receive_auth_tag_matches_actual_protected_packet_for_every_profile() {
+        use crate::rtp::ExtensionMap;
+        let crypto = crate::crypto::test_default_provider();
+        for (profile, expected) in [
+            (SrtpProfile::AES128_CM_SHA1_80, 10usize),
+            (SrtpProfile::AEAD_AES_128_GCM, 16),
+            (SrtpProfile::AEAD_AES_256_GCM, 16),
+        ] {
+            let material = vec![0x41; profile.keying_material_len()];
+            let key = KeyingMaterial::new(&material);
+            let mut tx = SrtpContext::new(crypto, profile, &key, true);
+            let mut rx = SrtpContext::new(crypto, profile, &key, true);
+            assert_eq!(rx.rtp_auth_tag_len(), expected);
+            for padding in [0usize, 20] {
+                let mut packet = vec![0x55; 12 + 100 + padding];
+                packet[0] = if padding == 0 { 0x80 } else { 0xa0 };
+                packet[1] = 111;
+                packet[2..4].copy_from_slice(&(padding as u16 + 1).to_be_bytes());
+                if padding != 0 {
+                    *packet.last_mut().unwrap() = padding as u8;
+                }
+                let header = RtpHeader::parse(&packet, &ExtensionMap::empty()).unwrap();
+                let seq = u64::from(header.sequence_number);
+                let encrypted = tx.protect_rtp(&packet, &header, seq);
+                assert_eq!(encrypted.len() - packet.len(), rx.rtp_auth_tag_len());
+                let decrypted = rx.unprotect_rtp(&encrypted, &header, seq).unwrap();
+                assert_eq!(decrypted, &packet[12..]);
+            }
+        }
+    }
