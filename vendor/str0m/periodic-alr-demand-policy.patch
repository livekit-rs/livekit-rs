+    pub(crate) fn cancel_periodic_alr_probes(&mut self) -> (bool, Vec<TwccClusterId>) {
+        let active_cancelled = self
+            .probe_queue
+            .front()
+            .is_some_and(|p| p.config().kind() == crate::bwe::ProbeKind::PeriodicAlr);
+        let mut keep = VecDeque::new();
+        let mut cancelled = Vec::new();
+        while let Some(probe) = self.probe_queue.pop_front() {
+            if probe.config().kind() == crate::bwe::ProbeKind::PeriodicAlr {
+                cancelled.push(probe.config().cluster());
+            } else {
+                keep.push_back(probe);
+            }
+        }
+        self.probe_queue = keep;
+        if active_cancelled {
+            self.next_poll_queue = None;
+            self.request_immediate_timeout();
+        }
+        (active_cancelled, cancelled)
