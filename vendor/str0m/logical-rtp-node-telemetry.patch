+//! Process-node media accounting, independent of transient stream stats objects.
+//! Fixed LiveKit telemetry counts logical RTP header + payload + padding, after
+//! authentication, excluding SRTP/SRTCP/DTLS/ICE. Pion strips RTX OSN before its
+//! receiver and accounts retransmission payload without that transport prefix.
+use std::ops::AddAssign;
+
+/// Cumulative authenticated/produced media traffic for one RTC lifetime.
+/// Replacing or removing an SSRC/media section cannot erase these counters.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct MediaTraffic {
+    /// Incoming logical RTP bytes, including authenticated duplicate packets.
+    pub bytes_in: u64,
+    /// Incoming authenticated RTP packets; excludes synthetic RED recovery.
+    pub packets_in: u64,
+    /// All outgoing logical RTP bytes, including padding and retransmissions.
+    pub bytes_out: u64,
+    /// All outgoing RTP packets, including padding and retransmissions.
+    pub packets_out: u64,
+    /// Outgoing retransmission logical RTP bytes, a subset of bytes_out.
+    pub retransmit_bytes_out: u64,
+    /// Outgoing retransmissions, a subset of packets_out.
+    pub retransmit_packets_out: u64,
+    /// Outgoing primary RTP bytes, excluding retransmissions/padding.
+    pub primary_bytes_out: u64,
+    /// Outgoing primary RTP packets, excluding retransmissions/padding.
+    pub primary_packets_out: u64,
+    /// Outgoing blank padding logical RTP bytes, excluding cached RTX probes.
+    pub padding_bytes_out: u64,
+    /// Outgoing blank padding RTP packets, excluding cached RTX probes.
+    pub padding_packets_out: u64,
+}
+impl MediaTraffic {
+    pub(crate) fn receive_rtp(&mut self, bytes: usize) {
+        self.bytes_in = self.bytes_in.saturating_add(bytes as u64);
+        self.packets_in = self.packets_in.saturating_add(1);
+    }
+    pub(crate) fn send_rtp(&mut self, bytes: usize, retransmission: bool, padding: bool) {
+        self.bytes_out = self.bytes_out.saturating_add(bytes as u64);
+        self.packets_out = self.packets_out.saturating_add(1);
+        if retransmission {
+            self.retransmit_bytes_out = self.retransmit_bytes_out.saturating_add(bytes as u64);
+            self.retransmit_packets_out = self.retransmit_packets_out.saturating_add(1);
+        } else if padding {
+            self.padding_bytes_out = self.padding_bytes_out.saturating_add(bytes as u64);
+            self.padding_packets_out = self.padding_packets_out.saturating_add(1);
+        } else {
+            self.primary_bytes_out = self.primary_bytes_out.saturating_add(bytes as u64);
+            self.primary_packets_out = self.primary_packets_out.saturating_add(1);
+        }
+    }
+}
+impl AddAssign for MediaTraffic {
+    fn add_assign(&mut self, other: Self) {
+        macro_rules! add {($($field:ident),+)=>{$(self.$field=self.$field.saturating_add(other.$field);)+};}
+        add!(
+            bytes_in,
+            packets_in,
+            bytes_out,
+            packets_out,
+            retransmit_bytes_out,
+            retransmit_packets_out,
+            primary_bytes_out,
+            primary_packets_out,
+            padding_bytes_out,
+            padding_packets_out
+        );
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn primary_padding_and_retry_are_disjoint_subsets_of_process_totals() {
+        let mut stats = MediaTraffic::default();
+        stats.receive_rtp(112);
+        stats.send_rtp(112, false, false);
+        stats.send_rtp(48, false, true);
+        stats.send_rtp(112, true, true);
+        assert_eq!(stats.bytes_out, 272);
+        assert_eq!(stats.packets_out, 3);
+        assert_eq!(stats.primary_packets_out, 1);
+        assert_eq!(stats.padding_packets_out, 1);
+        assert_eq!(stats.retransmit_packets_out, 1);
+        assert_eq!(
+            stats.bytes_out,
+            stats.primary_bytes_out + stats.padding_bytes_out + stats.retransmit_bytes_out
+        );
+    }
+}
