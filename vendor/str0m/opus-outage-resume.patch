+    fn can_resume_opus_after_outage(&self, start: usize, timeout: Option<Duration>) -> bool {
+        let Some(last) = self
+            .opus_outage_resume
+            .as_ref()
+            .and_then(|state| state.last.as_ref())
+        else {
+            return false;
+        };
+        let Some(timeout) = timeout.filter(|timeout| !timeout.is_zero()) else {
+            return false;
+        };
+        let entry = &self.queue[start];
+        let packet = &entry.meta;
+        let missing = (*packet.seq_no)
+            .saturating_sub(*last.sequence)
+            .saturating_sub(1);
+        if !entry.opus_outage_primary
+            || packet.header.ssrc != last.source
+            || missing < self.hold_back as u64
+        {
+            return false;
+        }
+        // A jump in only the sequence number or source timestamp can be a
+        // restart rather than an outage. Both clocks must advance beyond the
+        // configured reordering window and agree within one repair deadline.
+        let horizon = timeout.saturating_mul(u32::try_from(self.hold_back).unwrap_or(u32::MAX));
+        let receive_gap = packet.received.saturating_duration_since(last.received);
+        let source_gap = Duration::from_micros(packet.time.saturating_sub(last.time).as_micros());
+        receive_gap >= horizon && source_gap >= horizon && receive_gap.abs_diff(source_gap) <= timeout
+    }
