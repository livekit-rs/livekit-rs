+    #[test]
+    fn opted_in_opus_reorders_short_gaps_and_resumes_immediately_after_an_outage() {
+        let now = Instant::now();
+        let wait = Some(Duration::from_millis(40));
+        let mut buf = DepacketizingBuffer::new(CodecDepacketizer::Opus(OpusDepacketizer), 15);
+        let packet = |received_ms, seq, source_ms| {
+            let mut packet = meta(now + Duration::from_millis(received_ms), seq, 0, false);
+            packet.time = MediaTime::from_millis(source_ms);
+            packet.header.ssrc = Ssrc::from(55);
+            packet
+        };
+        buf.push_media(packet(0, 1, 20), [0xf8, 1], true);
+        assert!(buf.pop(now, wait).is_some());
+
+        buf.push_media(packet(30, 3, 60), [0xf8, 3], true);
+        assert!(buf.pop(now + Duration::from_millis(30), wait).is_none());
+        buf.push_media(packet(38, 2, 40), [0xf8, 2], false);
+        for sequence in 2u64..=3 {
+            let out = buf
+                .pop(now + Duration::from_millis(38), wait)
+                .unwrap()
+                .unwrap();
+            assert_eq!(out.seq_range(), sequence.into()..=sequence.into());
+        }
+
+        let resumed = now + Duration::from_millis(970);
+        buf.push_media(packet(970, 50, 1000), [0xf8, 50], true);
+        let out = buf.pop(resumed, wait).unwrap().unwrap();
+        assert_eq!(out.seq_range(), SeqNo::from(50)..=SeqNo::from(50));
+        assert!(!out.contiguous, "preserve the missing RTP sequence range");
+    }
+
