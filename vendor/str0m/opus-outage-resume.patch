+        let now = Instant::now();
+        let wait = Some(Duration::from_millis(40));
+        let packet = |received_ms, seq, source_ms, ssrc| {
+            let mut packet = meta(now + Duration::from_millis(received_ms), seq, 0, false);
+            packet.time = MediaTime::from_millis(source_ms);
+            packet.header.ssrc = Ssrc::from(ssrc);
+            packet
+        };
+        for (next, primary) in [
+            (packet(960, 49, 980, 66), true),
+            (packet(960, 49, 20, 55), true),
+            (packet(30, 49, 980, 55), true),
+            (packet(960, 49, 1300, 55), true),
+            (packet(960, 49, 980, 55), false),
+        ] {
+            let mut buf = DepacketizingBuffer::new(CodecDepacketizer::Opus(OpusDepacketizer), 15);
+            buf.push_media(packet(0, 1, 20, 55), [0xf8, 1], true);
+            assert!(buf.pop(now, wait).is_some());
+            let received = next.received;
+            buf.push_media(next, [0xf8, 49], primary);
+            assert!(buf.pop(received, wait).is_none());
+        }
+    }
