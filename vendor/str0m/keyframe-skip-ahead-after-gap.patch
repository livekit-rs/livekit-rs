+    /// Fixed LiveKit (Go) forwards packets as they arrive, so after an upstream gap a
+    /// subscriber decodes the next keyframe as soon as it arrives. This frame-based buffer
+    /// would instead hold that keyframe behind older frames still waiting for retransmission,
+    /// up to `hold_back` frames or the reordering timeout (30 frames / 2 s by default), which
+    /// delays recovery after a publisher outage by up to seconds. When the head of the queue is
+    /// blocked — an incomplete frame or a sequence gap before the first complete frame — and a
+    /// later complete frame is a VP8/VP9 keyframe, drop everything before that keyframe. Frames
+    /// before a keyframe cannot change what the decoder shows after it.
+    fn skip_to_blocked_keyframe(&mut self) {
+        let Some((first_start, _, _)) = self.first_segment() else {
+            return;
+        };
+        let expired = matches!(self.last_processed, Some(LastProcessed::Expired(_)));
+        let blocked = self.first_incomplete_frame().is_some()
+            || expired
+            || !self.is_following_last(first_start);
+        if !blocked {
+            return;
+        }
+        let starts: Vec<usize> = self
+            .segments
+            .iter()
+            .map(|&(start, _, _)| start - self.segments_offset)
+            .collect();
+        let Some(&keyframe) = starts
+            .iter()
+            .find(|&&start| start > 0 && self.segment_starts_keyframe(start))
+        else {
+            return;
+        };
+        let last = self.queue[keyframe - 1].meta.seq_no;
+        self.queue.drain(0..keyframe);
+        self.segments_dirty = true;
+        self.depack_cache = None;
+        self.last_processed = Some(LastProcessed::Expired(last));
+        self.update_segments();
+    }
+
+    /// Whether the complete frame starting at queue index `start` is a VP8/VP9 keyframe.
+    /// Probed from its first packet with a fresh depacketizer, so the stream's own
+    /// depacketizer state is untouched. Other codecs are never treated as skippable.
+    fn segment_starts_keyframe(&self, start: usize) -> bool {
+        let packet = self.queue[start].remaining();
+        let mut extra = CodecExtra::None;
+        let mut out = Vec::new();
+        let probed = match &self.depack {
+            CodecDepacketizer::Vp8(_) => {
+                super::Vp8Depacketizer::default().depacketize(packet, &mut out, &mut extra)
+            }
+            CodecDepacketizer::Vp9(_) => {
+                super::Vp9Depacketizer::default().depacketize(packet, &mut out, &mut extra)
+            }
+            _ => return false,
+        };
+        probed.is_ok() && codec_extra_is_keyframe(&extra)
+    }
