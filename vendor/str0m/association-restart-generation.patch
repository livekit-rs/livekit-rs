+    #[test]
+    fn authenticated_peer_restart_changes_generation_and_keeps_application_channel_open() {
+        let now = Instant::now();
+        let (mut original, mut server) = connect_client_server();
+        let pump = |from: &mut RtcSctp, to: &mut RtcSctp| {
+            let mut wire = vec![];
+            while let Some(event) = from.do_poll() {
+                if let SctpEvent::Transmit { packets } = event {
+                    for packet in packets {
+                        to.handle_input(now, &packet);
+                        wire.extend(packet);
+                    }
+                }
+            }
+            wire
+        };
+        original.open_stream(
+            0,
+            ChannelConfig {
+                ordered: true,
+                ..Default::default()
+            },
+        );
+        pump(&mut original, &mut server);
+        pump(&mut server, &mut original);
+        assert_eq!(server.association_generation(), Some(0));
+        server.write(0, true, b"accepted-before-restart").unwrap();
+        let mut replacement = RtcSctp::new(DATAGRAM_MTU_TARGET);
+        replacement.init(true, now, None, None).unwrap();
+        for _ in 0..20 {
+            pump(&mut replacement, &mut server);
+            pump(&mut server, &mut replacement);
+            if server.association_generation() == Some(1)
+                && replacement.state == RtcSctpState::Established
+            {
+                break;
+            }
+        }
+        assert_eq!(server.association_generation(), Some(1));
+        assert_eq!(replacement.state, RtcSctpState::Established);
+        assert_eq!(
+            original.association_generation(),
+            Some(0),
+            "a different peer connection is independent"
+        );
+        assert_eq!(
+            server.buffered_amount(0),
+            0,
+            "accepted old-generation DATA is discarded, not retried"
+        );
+        assert_eq!(
+            entry_by_id(&server.entries, 0).unwrap().state,
+            StreamEntryState::Open
+        );
+        replacement.open_stream(
+            0,
+            ChannelConfig {
+                negotiated: Some(0),
+                ..Default::default()
+            },
+        );
+        while replacement.do_poll().is_some() {}
+        server.write(0, true, b"fresh-after-restart").unwrap();
+        let wire = pump(&mut server, &mut replacement);
+        assert!(
+            wire.windows(b"fresh-after-restart".len())
+                .any(|window| window == b"fresh-after-restart")
+        );
+        assert!(
+            !wire
+                .windows(b"accepted-before-restart".len())
+                .any(|window| window == b"accepted-before-restart")
+        );
+    }
