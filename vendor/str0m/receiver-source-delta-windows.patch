+//! Authenticated receive-source accounting before delivery de-duplication.
+use crate::{
+    format::Codec,
+    media::{Mid, Pt},
+};
+use std::{
+    collections::{BTreeSet, HashMap},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicU64, Ordering},
+    },
+    time::Instant,
+};
+
+/// Cumulative counters for one native receive-stream generation. Consuming a
+/// snapshot never resets the source, replay state, or another receive stream.
+#[derive(Clone, Debug)]
+pub struct ReceiveTraffic {
+    /// Stable identity, including when an SSRC or MID is reused later.
+    pub source_id: u64,
+    /// Negotiated media section owning primary and RTX traffic.
+    pub mid: Mid,
+    /// Primary SSRC; repaired traffic belongs to the same source.
+    pub ssrc: u32,
+    /// Time of the first authenticated real packet, not SDP creation.
+    pub first_at: Option<Instant>,
+    /// Codec of that first primary packet.
+    pub codec: Option<Codec>,
+    /// First packet is an RFC2198 RED carrier around the primary codec.
+    pub red: bool,
+    /// Original main payload type; RTX's transport payload type is excluded.
+    pub payload_type: Option<Pt>,
+    /// A later authenticated primary packet changed the receiver payload type.
+    pub codec_changed: bool,
+    /// Logical RTP bytes including authenticated duplicates, excluding RTX OSN.
+    pub bytes: u64,
+    /// Authenticated packets excluding synthetic RED recovery.
+    pub packets: u64,
+    /// Extended primary sequence-number span, including gaps, since source start.
+    pub expected_packets: u64,
+    /// Authenticated duplicate original sequence numbers, including repaired duplicates.
+    pub duplicates: u64,
+    /// Requested SNs generated by this receiver, before transport emission.
+    pub nacks: u64,
+    /// Final source snapshot; its owning logical receiver may still be alive.
+    pub retired: bool,
+}
+#[derive(Debug, Default)]
+struct Pending {
+    sources: HashMap<u64, ReceiveTraffic>,
+    nacks: u64,
+}
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Registry(Arc<Mutex<Pending>>);
+impl Registry {
+    pub fn take(&self) -> Vec<ReceiveTraffic> {
+        self.0
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .sources
+            .drain()
+            .map(|(_, v)| v)
+            .collect()
+    }
+    pub fn generated_nacks(&self) -> u64 {
+        self.0.lock().unwrap_or_else(|p| p.into_inner()).nacks
+    }
+}
+static NEXT_SOURCE: AtomicU64 = AtomicU64::new(1);
+#[derive(Debug)]
+pub(crate) struct Tracker {
+    pub registry: Registry,
+    value: ReceiveTraffic,
+    highest_primary: Option<u64>,
+    start_sequence: Option<u64>,
+    seen: BTreeSet<u64>,
+}
+impl Tracker {
+    pub fn new(mid: Mid, ssrc: u32, registry: Registry) -> Self {
+        Self {
+            registry,
+            value: ReceiveTraffic {
+                source_id: NEXT_SOURCE.fetch_add(1, Ordering::Relaxed),
+                mid,
+                ssrc,
+                first_at: None,
+                codec: None,
+                red: false,
+                payload_type: None,
+                codec_changed: false,
+                bytes: 0,
+                packets: 0,
+                expected_packets: 0,
+                duplicates: 0,
+                nacks: 0,
+                retired: false,
+            },
+            highest_primary: None,
+            start_sequence: None,
+            seen: BTreeSet::new(),
+        }
+    }
+    pub(crate) fn is_started(&self) -> bool {
+        self.value.first_at.is_some()
+    }
+    pub fn receive(
+        &mut self,
+        bytes: usize,
+        codec: Codec,
+        pt: Pt,
+        repair: bool,
+        red: bool,
+        seq: u64,
+        original_sequence: Option<u16>,
+        has_media: bool,
+        now: Instant,
+    ) {
+        let seq = original_sequence
+            .map(|original| crate::rtp_::extend_u16(self.highest_primary, original))
+            .unwrap_or(seq);
+        if self.value.first_at.is_none() {
+            // Fixed Buffer.calc rejects pre-start RTX; RTPStatsReceiver.Update
+            // does not start on padding-only packets either.
+            if repair || !has_media {
+                return;
+            }
+            self.start_sequence = Some(seq);
+            self.value.first_at = Some(now);
+            self.value.codec = Some(codec);
+            self.value.red = red;
+            self.value.payload_type = Some(pt);
+        } else if !repair
+            && has_media
+            && codec.is_video()
+            && self.highest_primary.is_none_or(|highest| seq > highest)
+            && self.value.payload_type != Some(pt)
+        {
+            self.value.codec_changed = true;
+        }
+        if seq < self.start_sequence.unwrap() {
+            return;
+        }
+        let in_history = self
+            .highest_primary
+            .is_none_or(|highest| highest.saturating_sub(seq) < 8192);
+        if in_history && !self.seen.insert(seq) {
+            self.value.duplicates = self.value.duplicates.saturating_add(1);
+        }
+        if self.highest_primary.is_none_or(|highest| seq > highest) {
+            self.highest_primary = Some(seq);
+            self.value.expected_packets = seq
+                .saturating_sub(self.start_sequence.unwrap())
+                .saturating_add(1);
+            while self
+                .seen
+                .first()
+                .is_some_and(|oldest| seq.saturating_sub(*oldest) >= 8192)
+            {
+                self.seen.pop_first();
+            }
+        }
+        self.value.bytes = self.value.bytes.saturating_add(bytes as u64);
+        self.value.packets = self.value.packets.saturating_add(1);
+        self.publish();
+    }
+    pub fn nack(&mut self, count: u64) {
+        let mut pending = self.registry.0.lock().unwrap_or_else(|p| p.into_inner());
+        pending.nacks = pending.nacks.saturating_add(count);
+        if self.value.first_at.is_some() {
+            self.value.nacks = self.value.nacks.saturating_add(count);
+            pending
+                .sources
+                .insert(self.value.source_id, self.value.clone());
+        }
+    }
+    fn publish(&self) {
+        self.registry
+            .0
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .sources
+            .insert(self.value.source_id, self.value.clone());
+    }
+}
+impl Drop for Tracker {
+    fn drop(&mut self) {
+        self.value.retired = true;
+        self.publish();
+    }
+}
