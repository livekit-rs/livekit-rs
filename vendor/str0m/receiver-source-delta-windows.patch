+mod tests {
+    use super::*;
+    #[test]
+    fn initial_padding_and_rtx_do_not_start_then_original_sequence_span_and_repairs_account() {
+        let registry = Registry::default();
+        let mut tracker = Tracker::new(Mid::from("v"), 101, registry.clone());
+        let now = Instant::now();
+        let pt = Pt::from(98);
+        tracker.receive(16, Codec::Vp9, pt, false, false, 65000, None, false, now);
+        tracker.receive(20, Codec::Vp9, pt, true, false, 9, Some(1), true, now);
+        tracker.nack(1);
+        assert!(
+            registry.take().is_empty(),
+            "pre-start input must not publish a source"
+        );
+        assert_eq!(
+            registry.generated_nacks(),
+            1,
+            "raw diagnostic does not invent a started source"
+        );
+        tracker.receive(20, Codec::Vp9, pt, false, false, 100, None, true, now);
+        tracker.receive(20, Codec::Vp9, pt, false, false, 102, None, true, now);
+        // Original sequence from RTX recovers the missing packet, not the
+        // independent repair sequence 50000 (which would invent a huge gap).
+        tracker.receive(20, Codec::Vp9, pt, true, false, 50000, Some(101), true, now);
+        tracker.receive(20, Codec::Vp9, pt, true, false, 50001, Some(101), true, now);
+        let row = registry.take().pop().unwrap();
+        assert_eq!(
+            (row.bytes, row.packets, row.expected_packets, row.duplicates),
+            (80, 4, 3, 1)
+        );
+        assert_eq!(row.nacks, 0, "pre-start NACK cannot be resurrected");
+        assert!(!row.codec_changed);
+        tracker.receive(
+            23,
+            Codec::Vp8,
+            Pt::from(96),
+            false,
+            false,
+            102,
+            None,
+            true,
+            now,
+        );
+        assert!(
+            !registry.take().pop().unwrap().codec_changed,
+            "equal-SN duplicate is out of order in original Go"
+        );
+        tracker.receive(
+            23,
+            Codec::Vp8,
+            Pt::from(96),
+            false,
+            false,
+            103,
+            None,
+            true,
+            now,
+        );
+        assert!(registry.take().pop().unwrap().codec_changed);
+    }
+}
