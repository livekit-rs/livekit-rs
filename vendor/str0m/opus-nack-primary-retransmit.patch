+    /// Match Pion configureSenderAudio's sticky session-wide Opus NACK
+    /// removal. Never re-enable it during m-line reuse or later negotiation.
+    pub fn disable_opus_nack(&mut self) {
+        for payload in self.codec_config.iter_mut() {
+            if payload.spec().codec == crate::format::Codec::Opus {
+                payload.set_fb_nack(false);
+            }
+        }
+        let audio_mids: Vec<_> = self
+            .medias
+            .iter()
+            .filter(|media| media.kind().is_audio())
+            .map(|media| media.mid())
+            .collect();
+        for mid in audio_mids {
+            for stream in self.streams.streams_tx_by_mid(mid) {
+                stream.clear_retransmissions();
+            }
+        }
+    }
+
