+        let mut managed =
+            StreamTx::new(43.into(), None, MidRid("managed".into(), None), false, 1200);
+        let mut sequence = 100u64;
+        for (index, (enabled, managed_stream)) in [(false, false), (true, true), (true, false)]
+            .into_iter()
