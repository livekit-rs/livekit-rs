+            Self::Accepted {
+                restarted: true,
+                ..
+            }
+        )
+    }
+    pub fn rejected(self) -> bool {
+        matches!(self, Self::Rejected)
+    }
+    pub fn duplicated(self) -> bool {
+        matches!(
+            self,
+            Self::Accepted {
+                duplicate: true,
+                ..
+            }
+        )
+    }
+}
