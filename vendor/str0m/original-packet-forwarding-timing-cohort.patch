+/// Actual authenticated receive timing of an original RTP packet.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ForwardingPacket {
+    /// Actual input datagram arrival, before codec frame assembly.
+    pub received: Instant,
+    /// Original receiver sequence/timestamp admission classified it out of order.
+    pub out_of_order: bool,
+    /// Replayed from a prebinding raw packet buffer (distinct from depayload wait).
+    pub buffered: bool,
+}
+
+// Local-only metadata lives behind the existing type map. It has no wire
