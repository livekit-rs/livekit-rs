+        self.pacer.cancel_probes(false);
+        while let Some(id) = self.pacer.check_probe_complete(now) {
+            bwe.end_probe(now, id);
+        }
+        self.streams.clear_pending_padding();
+        self.streams.set_probe_media(None);
+        self.pacer.start_probe(config);
