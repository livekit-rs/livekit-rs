+        // These are real packet polls after cancellation: the outstanding RTX
+        // and queued media remain sendable, but no expired padding follows.
+        let exts = ExtensionMap::standard();
+        let codecs = CodecConfig::new_with_defaults();
+        let mut buf = vec![];
+        let mut twcc = 0;
+        let resend = stream
+            .poll_packet(now, &exts, Some(&mut twcc), codecs.params(), &mut buf)
+            .unwrap();
+        assert_eq!(resend.header.ssrc, 44.into());
+        assert_eq!(*resend.seq_no, 65_535);
+        assert!(!resend.is_padding);
+        let media = stream
+            .poll_packet(now, &exts, Some(&mut twcc), codecs.params(), &mut buf)
+            .unwrap();
