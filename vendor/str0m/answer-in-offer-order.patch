+    #[test]
+    fn answer_in_offer_order_lists_the_offerers_preference_first() {
+        crate::init_crypto_default();
+
+        let now = Instant::now();
+        // Offerer prefers H.264, answerer is configured VP8-first.
+        let mut rtc1 = Rtc::builder()
+            .clear_codecs()
+            .enable_h264(true)
+            .enable_vp8(true)
+            .build(now);
+        let mut rtc2 = Rtc::builder()
+            .clear_codecs()
+            .enable_vp8(true)
+            .enable_h264(true)
+            .set_answer_in_offer_order(true)
+            .build(now);
+        let mut change1 = rtc1.sdp_api();
+        change1.add_media(MediaKind::Video, Direction::SendOnly, None, None, None);
+        let (offer1, _) = change1.apply().unwrap();
+        let offered: Vec<Codec> = offer1.media_lines[0]
+            .pts
+            .iter()
+            .map(|pt| resolve_pt(&offer1.media_lines[0], *pt).codec)
+            .filter(|c| *c != Codec::Rtx)
+            .collect();
+        let answer = rtc2.sdp_api().accept_offer(offer1).unwrap();
+        let line = &answer.media_lines[0];
+        let answered: Vec<Codec> = line
+            .pts
+            .iter()
+            .map(|pt| resolve_pt(line, *pt).codec)
+            .filter(|c| *c != Codec::Rtx)
+            .collect();
+        let mut expect = offered.clone();
+        expect.retain(|c| answered.contains(c));
+        assert_eq!(answered, expect, "answer follows the offer's codec order");
+        assert_eq!(answered[0], Codec::H264);
+    }
+
