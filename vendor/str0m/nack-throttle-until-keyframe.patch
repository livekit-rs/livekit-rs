+    #[test]
+    fn nack_throttle_ignores_new_nacks_until_cleared() {
+        let now = Instant::now();
+        let mut codecs = CodecConfig::empty();
+        codecs.enable_opus(true, false);
+        for p in codecs.iter_mut() {
+            p.set_fb_nack(true);
+        }
+        let mut stream = StreamTx::new(42.into(), None, MidRid("aud".into(), None), false, 1200);
+        stream.set_rtx_cache(200, DEFAULT_RTX_CACHE_DURATION, None);
+        let exts = ExtensionMap::standard();
+        let mut buf = vec![];
+        for seq in [100u64, 101] {
+            stream.write_rtp(
+                RtpWrite::new(111.into(), seq.into(), 48_000, now, vec![0xf8, 0xff, 0xfe])
+                    .nackable(true),
+            );
+        }
+        stream.send_queue.handle_timeout(now);
+        while stream
+            .poll_packet(now, &exts, None, codecs.params(), &mut buf)
+            .is_some()
+        {}
+        let nack = |pid| [NackEntry { pid, blp: 0 }].into_iter();
+        assert!(!stream.nack_throttled());
+        stream.set_nack_throttled(true);
+        stream.handle_nack(nack(100), now);
+        assert!(
+            stream
+                .poll_packet(now, &exts, None, codecs.params(), &mut buf)
+                .is_none(),
+            "a throttled stream does not answer NACKs"
+        );
+        stream.set_nack_throttled(false);
+        stream.handle_nack(nack(101), now);
+        let resend = stream
+            .poll_packet(now, &exts, None, codecs.params(), &mut buf)
+            .expect("NACKs are answered again once cleared");
+        assert_eq!(resend.header.sequence_number, 101);
+    }
