+                    },
+                    1024,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 41u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: Some(512u32.into()),
+            })
+            .unwrap();
+        assert_eq!(client.local_max_data - initial_max, 512);
+
+        // The peer abandons everything after all.
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 43u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: None,
+            })
+            .unwrap();
+        assert_eq!(
+            client.local_max_data - initial_max,
+            1024,
+            "the bytes that just became unreliable are credited back"
+        );
+
+        // Nothing stays readable, and the first reset's error code is the one reported.
+        let mut pending = Retransmits::default();
+        let mut recv = RecvStream {
+            id,
+            state: &mut client,
+            pending: &mut pending,
+        };
+        let mut chunks = recv.read(true).unwrap();
+        assert_eq!(
+            chunks.next(usize::MAX).unwrap_err(),
+            crate::ReadError::Reset(41u32.into())
+        );
+        let _ = chunks.finalize();
+    }
+
+    /// Data that arrives past the reliable prefix is dropped instead of being buffered: the peer
+    /// abandoned it, and the connection-level accounting must not be disturbed by it.
+    #[test]
+    fn reset_stream_at_discards_data_beyond_the_reliable_prefix() {
+        let mut client = make(Side::Client);
+        let id = StreamId::new(Side::Server, Dir::Uni, 0);
+        let initial_max = client.local_max_data;
+
+        assert_eq!(
+            client
+                .received(
+                    frame::Stream {
+                        id,
+                        offset: 0,
+                        fin: false,
+                        data: Bytes::from_static(&[5; 1024]),
+                    },
+                    1024,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 45u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: Some(512u32.into()),
+            })
+            .unwrap();
+        assert_eq!(client.local_max_data - initial_max, 512);
+
+        // The abandoned tail is retransmitted: it must be dropped, not buffered.
+        assert_eq!(
+            client
+                .received(
+                    frame::Stream {
+                        id,
+                        offset: 512,
+                        fin: false,
+                        data: Bytes::from_static(&[4; 512]),
+                    },
+                    512,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+        assert_eq!(
+            client.data_recvd, 1024,
+            "the abandoned tail must not be charged to the connection window twice"
+        );
+
+        // Only the reliable prefix is delivered.
+        {
+            let mut pending = Retransmits::default();
+            let mut recv = RecvStream {
+                id,
+                state: &mut client,
+                pending: &mut pending,
+            };
+            let mut chunks = recv.read(true).unwrap();
+            let chunk = chunks
+                .next(usize::MAX)
+                .unwrap()
+                .expect("the reliable prefix must stay readable");
+            assert_eq!(chunk.offset, 0);
+            assert_eq!(chunk.bytes.len(), 512);
+            assert_eq!(
+                chunks.next(usize::MAX).unwrap_err(),
+                crate::ReadError::Reset(45u32.into())
+            );
+            let _ = chunks.finalize();
+        }
+        assert_eq!(
+            client.local_max_data - initial_max,
+            1024,
+            "the whole final size is credited back once the prefix has been read"
+        );
+    }
+
+    /// A repeated reset may shrink the reliable prefix before the prefix has arrived. The
+    /// application must then wait for the *smaller* prefix, and the bytes between the two
+    /// reliable sizes must never be delivered.
+    #[test]
+    fn reset_stream_at_narrowing_before_the_prefix_arrived_waits_for_the_smaller_prefix() {
+        let mut client = make(Side::Client);
+        let id = StreamId::new(Side::Server, Dir::Uni, 0);
+        let initial_max = client.local_max_data;
+
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 47u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: Some(512u32.into()),
+            })
+            .unwrap();
+        assert_eq!(client.local_max_data - initial_max, 512);
+
+        // The peer shrinks the promise before a single byte arrived.
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 49u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: Some(256u32.into()),
+            })
+            .unwrap();
+        assert_eq!(
+            client.local_max_data - initial_max,
+            512 + 256,
+            "the newly abandoned bytes are credited back"
+        );
+
+        // The bytes between the two reliable sizes arrive and must be dropped.
+        assert_eq!(
+            client
+                .received(
+                    frame::Stream {
+                        id,
+                        offset: 256,
+                        fin: false,
+                        data: Bytes::from_static(&[3; 256]),
+                    },
+                    256,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+
+        // The smaller prefix arrives and completes the promise.
+        assert_eq!(
+            client
+                .received(
+                    frame::Stream {
+                        id,
+                        offset: 0,
+                        fin: false,
+                        data: Bytes::from_static(&[2; 256]),
+                    },
+                    256,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+
+        {
+            let mut pending = Retransmits::default();
+            let mut recv = RecvStream {
+                id,
+                state: &mut client,
+                pending: &mut pending,
+            };
+            let mut chunks = recv.read(true).unwrap();
+            let chunk = chunks
+                .next(usize::MAX)
+                .unwrap()
+                .expect("the shrunk prefix must be readable");
+            assert_eq!(chunk.offset, 0);
+            assert_eq!(chunk.bytes.len(), 256);
+            assert_eq!(
+                chunks.next(usize::MAX).unwrap_err(),
+                crate::ReadError::Reset(47u32.into())
+            );
+            let _ = chunks.finalize();
+        }
+        assert_eq!(
+            client.local_max_data - initial_max,
+            1024,
+            "the whole final size is credited back once the prefix has been read"
+        );
+    }
+
+    /// An out-of-order prefix keeps the stream alive: the peer may still send the bytes that
+    /// fill the hole, so the stream must not be treated as finished, the read must not report
+    /// the reset, and the prefix must be delivered in offset order once the hole is filled.
+    #[test]
+    fn reset_stream_at_keeps_an_out_of_order_prefix_open() {
+        let mut client = make(Side::Client);
+        let id = StreamId::new(Side::Server, Dir::Uni, 0);
+        let initial_max = client.local_max_data;
+
+        // The upper half of the promised prefix arrives first.
+        assert_eq!(
+            client
+                .received(
+                    frame::Stream {
+                        id,
+                        offset: 256,
+                        fin: false,
+                        data: Bytes::from_static(&[2; 256]),
+                    },
+                    256,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+        assert_eq!(client.data_recvd, 512);
+
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 51u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: Some(512u32.into()),
+            })
+            .unwrap();
+        assert_eq!(
+            client.data_recvd, 1024,
+            "the final size is charged to the connection window"
+        );
+        assert_eq!(
+            client.local_max_data - initial_max,
+            512,
+            "the abandoned tail is credited back, the prefix stays charged"
+        );
+
+        {
+            let mut pending = Retransmits::default();
+            let mut recv = RecvStream {
+                id,
+                state: &mut client,
+                pending: &mut pending,
+            };
+            let mut chunks = recv.read(true).unwrap();
+            assert_eq!(
+                chunks.next(usize::MAX).unwrap_err(),
+                crate::ReadError::Blocked,
+                "the prefix has a hole, so the reset must not be reported yet"
+            );
+            let _ = chunks.finalize();
+        }
+        assert!(
+            client.can_send_flow_control(id),
+            "the peer may still send the missing prefix bytes"
+        );
+
+        // The missing lower half arrives and completes the prefix.
+        assert_eq!(
+            client
+                .received(
+                    frame::Stream {
+                        id,
+                        offset: 0,
+                        fin: false,
+                        data: Bytes::from_static(&[1; 256]),
+                    },
+                    256,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+        assert_eq!(
+            client.data_recvd, 1024,
+            "the late prefix was already accounted for by the final size"
+        );
+
+        {
+            let mut pending = Retransmits::default();
+            let mut recv = RecvStream {
+                id,
+                state: &mut client,
+                pending: &mut pending,
+            };
+            let mut chunks = recv.read(true).unwrap();
+            let first = chunks
+                .next(usize::MAX)
+                .unwrap()
+                .expect("the lower half of the prefix must be readable");
+            assert_eq!(first.offset, 0);
+            assert_eq!(&first.bytes[..], &[1u8; 256][..]);
+            let second = chunks
+                .next(usize::MAX)
+                .unwrap()
+                .expect("the upper half of the prefix must be readable");
+            assert_eq!(second.offset, 256);
+            assert_eq!(&second.bytes[..], &[2u8; 256][..]);
+            assert_eq!(
+                chunks.next(usize::MAX).unwrap_err(),
+                crate::ReadError::Reset(51u32.into())
+            );
+            let _ = chunks.finalize();
+        }
+        assert_eq!(
+            client.local_max_data - initial_max,
+            1024,
+            "the whole final size is credited back once the prefix has been read"
+        );
+        assert!(
+            !client.can_send_flow_control(id),
+            "the prefix is complete, so no further stream data is expected"
+        );
+    }
+
+    /// Once a repeated reset has shrunk the reliable prefix to nothing, data that still arrives
+    /// for the abandoned prefix is dropped and the reset is reported right away.
+    #[test]
+    fn reset_stream_at_narrowed_to_zero_drops_late_prefix_data() {
+        let mut client = make(Side::Client);
+        let id = StreamId::new(Side::Server, Dir::Uni, 0);
+        let initial_max = client.local_max_data;
+
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 53u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: Some(512u32.into()),
+            })
+            .unwrap();
+
+        // The peer shrinks the promise to nothing.
+        let _ = client
+            .received_reset(frame::ResetStream {
+                id,
+                error_code: 55u32.into(),
+                final_offset: 1024u32.into(),
+                reliable_size: Some(0u32.into()),
+            })
+            .unwrap();
+        assert_eq!(
+            client.local_max_data - initial_max,
+            512 + 512,
+            "the bytes that just became unreliable are credited back"
+        );
+
+        // Data for the abandoned prefix arrives late and must be dropped.
+        assert_eq!(
+            client
+                .received(
+                    frame::Stream {
+                        id,
+                        offset: 0,
+                        fin: false,
+                        data: Bytes::from_static(&[1; 256]),
+                    },
+                    256,
+                )
+                .unwrap(),
+            ShouldTransmit(false)
+        );
+        assert_eq!(
+            client.data_recvd, 1024,
+            "the abandoned bytes must not be charged to the connection window twice"
+        );
+
+        // The read reports the error of the first reset right away.
+        let mut pending = Retransmits::default();
+        let mut recv = RecvStream {
+            id,
+            state: &mut client,
+            pending: &mut pending,
+        };
+        let mut chunks = recv.read(true).unwrap();
+        assert_eq!(
+            chunks.next(usize::MAX).unwrap_err(),
+            crate::ReadError::Reset(53u32.into())
+        );
+        let _ = chunks.finalize();
+    }
 }
