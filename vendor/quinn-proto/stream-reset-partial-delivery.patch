+    /// The offset up to which the stream data is contiguous
+    ///
+    /// Bytes that have already been read count as contiguous, and so do buffered chunks that
+    /// follow them without a gap. This is what tells a partial-delivery reset whether the
+    /// promised prefix has arrived in full.
+    pub(super) fn contiguous_end(&self) -> u64 {
+        let mut end = self.bytes_read;
+        let mut chunks: Vec<&Buffer> = self.data.iter().collect();
+        chunks.sort_by_key(|chunk| chunk.offset);
+        for chunk in chunks {
+            if chunk.offset > end {
+                break;
+            }
+            end = end.max(chunk.offset + chunk.bytes.len() as u64);
+        }
+        end
+    }
+
+    /// Discard buffered data at or past `limit`, retaining the prefix below it
+    ///
+    /// Used for `RESET_STREAM_AT` partial delivery, where the sender abandons the stream
+    /// but promises that everything before `limit` was transmitted reliably.
+    pub(super) fn truncate(&mut self, limit: u64) {
+        if self.end <= limit {
+            // Nothing buffered lies past the reliable size
+            return;
+        }
+        let old = mem::take(&mut self.data);
+        self.buffered = 0;
+        self.allocated = 0;
+        let mut kept = BinaryHeap::with_capacity(old.len());
+        // `into_sorted_vec` yields ascending offsets, so chunks entirely past the limit can be
+        // dropped without inspecting the rest of the heap.
+        for mut buffer in old.into_sorted_vec() {
+            if buffer.offset >= limit {
+                break;
+            }
+            let retain = (limit - buffer.offset) as usize;
+            if retain < buffer.bytes.len() {
+                buffer.bytes.truncate(retain);
+            }
+            self.buffered += buffer.bytes.len();
+            self.allocated += buffer.allocation_size;
+            kept.push(buffer);
+        }
+        self.data = kept;
+        self.end = limit;
+    }
 }
 
