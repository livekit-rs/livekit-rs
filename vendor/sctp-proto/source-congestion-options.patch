+            let mut initial_bits = String::new();
+            for _ in 0..5 {
+                a.outbound_queue.push(vec![ChunkPayloadData {
+                    beginning_fragment: true,
+                    ending_fragment: true,
+                    payload_type: PayloadProtocolIdentifier::Binary,
