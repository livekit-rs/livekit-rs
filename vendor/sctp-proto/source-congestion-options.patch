+                    reliability: Some((kind, value)),
+                    ..Default::default()
+                }]);
+                let ch = a.send_next_data_chunk(initial).unwrap();
+                initial_bits.push(if a.outbound_queue.get(ch.tsn).unwrap().abandoned {
+                    '1'
+                } else {
+                    '0'
+                });
+                a.outbound_queue.get_mut(ch.tsn).unwrap().miss_indicator = 3;
+            }
+            a.will_retransmit_fast = true;
