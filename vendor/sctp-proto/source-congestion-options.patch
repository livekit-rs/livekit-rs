 impl OutboundQueue {
+    /// Read-only finite inventory for source ACK membership. No TSN is guessed
+    /// from an untrusted ACK range or from a potentially sparse queue length.
+    pub(crate) fn inflight_tsns(&self) -> impl Iterator<Item = u32> + '_ {
+        self.inflight.sorted.iter().copied()
+    }
+
+    // Source PR keeps a shared raw head flag until every fragment has entered
+    // flight. Marking effective abandonment must not clear payload/buffer debt.
+    pub(crate) fn source_message_pending(&self, id: u64) -> bool {
+        self.pending.contains_message(id)
+    }
+    pub(crate) fn source_message_present(&self, id: u64) -> bool {
+        self.pending.contains_message(id)
+            || self
+                .inflight
+                .sorted
+                .iter()
+                .any(|tsn| self.inflight.get(*tsn).is_some_and(|c| c.message_id == id))
+    }
+    pub(crate) fn source_mark_message_abandoned(&mut self, id: u64) {
+        let tsns: Vec<_> = self.inflight.sorted.iter().copied().collect();
+        for tsn in tsns {
+            if let Some(c) = self.inflight.get_mut(tsn) {
+                if c.message_id == id {
+                    c.abandoned = true;
+                }
+            }
+        }
+    }
+
     pub(crate) fn next_message_id(&self) -> u64 {
         self.next_message_id
