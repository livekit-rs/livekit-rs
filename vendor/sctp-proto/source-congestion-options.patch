+            enabled += 1;
+            let value: u32 = cols[2].parse().unwrap();
+            let kind = match cols[1] {
+                "reliable" => ReliabilityType::Reliable,
+                "rexmit" => ReliabilityType::Rexmit,
+                "timed" => ReliabilityType::Timed,
+                _ => panic!("source kind"),
+            };
+            let initial = Instant::now();
