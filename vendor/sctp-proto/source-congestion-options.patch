+    fn source_wire_tsns(packets: &[Bytes]) -> Vec<u32> {
+        let mut result = vec![];
+        for packet in packets {
+            let mut off = 12;
+            while off < packet.len() {
+                assert!(off + 4 <= packet.len());
+                let n = u16::from_be_bytes([packet[off + 2], packet[off + 3]]) as usize;
+                assert!(n >= 4 && off + n <= packet.len());
+                if packet[off] == 0 {
+                    assert!(n >= 16);
+                    result.push(u32::from_be_bytes(
+                        packet[off + 4..off + 8].try_into().unwrap(),
+                    ));
+                }
+                off += (n + 3) & !3;
+            }
+        }
+        result
+    }
