+    fn source_stream_queue(a: &mut Association, kind: ReliabilityType, value: u32, bytes: usize) {
+        a.set_state(AssociationState::Established);
+        a.use_forward_tsn = true;
+        a.cumulative_tsn_ack_point = 0;
+        a.my_next_tsn = 1;
+        a.advanced_peer_tsn_ack_point = 0;
+        a.min_tsn2measure_rtt = 1;
+        let mut stream = a
+            .create_stream(0, false, PayloadProtocolIdentifier::Binary)
+            .unwrap();
+        stream.set_reliability_params(false, kind, value).unwrap();
+        stream
+            .write_sctp(
+                &Bytes::from(vec![0; bytes]),
+                PayloadProtocolIdentifier::Binary,
+            )
+            .unwrap();
+    }
+    fn source_ack_all(a: &mut Association, now: Instant) {
+        a.handle_sack(
+            &ChunkSelectiveAck {
+                cumulative_tsn_ack: a.my_next_tsn.wrapping_sub(1),
+                advertised_receiver_window_credit: 1024 * 1024,
+                ..Default::default()
+            },
+            now,
+        )
+        .unwrap();
+        a.gather_outbound(now);
+        assert_eq!(a.outbound_queue.inflight_bytes(), 0);
+        assert_eq!(a.streams.get(&0).unwrap().buffered_amount, 0);
+        assert!(
+            a.source_pr_abandoned.is_empty(),
+            "raw PR identity must retire with actual queue ownership"
+        );
+    }
