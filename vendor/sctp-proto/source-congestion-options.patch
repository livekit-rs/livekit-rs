+                    "finish" => {
+                        a.cumulative_tsn_ack_point = a.source_tlr.end_tsn;
+                        a.source_tlr.finish(true, a.cumulative_tsn_ack_point);
+                    }
+                    "reset16" => {
+                        a.source_tlr.first_units = 8;
+                        a.source_tlr.later_units = 5;
+                        for _ in 0..16 {
+                            a.source_begin_tlr(now);
+                            a.cumulative_tsn_ack_point = a.source_tlr.end_tsn;
+                            a.source_tlr.finish(true, a.cumulative_tsn_ack_point);
