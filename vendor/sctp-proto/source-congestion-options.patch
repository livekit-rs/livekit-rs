+        }
+        queue(&mut a, pending);
+        a.source_writer_pending.store(false, Ordering::Relaxed);
+        a.source_schedule_pto(now);
+        let delta = a
+            .source_tlr
+            .pto_deadline
+            .unwrap()
+            .duration_since(now)
