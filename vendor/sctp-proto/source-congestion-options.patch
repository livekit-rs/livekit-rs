+    fn compare_actual_fragment_rows(variable: &str, rto: bool) {
+        let data = std::fs::read_to_string(std::env::var(variable).unwrap()).unwrap();
+        let rows: Vec<_> = data
+            .lines()
+            .map(|line| line.split('\t').collect::<Vec<_>>())
+            .collect();
+        assert_eq!(rows.len(), 60);
+        let parse = |s: &str| {
+            s.split(',')
+                .filter(|s| !s.is_empty())
+                .map(|s| s.parse::<u32>().unwrap())
+                .collect::<Vec<_>>()
+        };
+        let bitvec = |b: bool| if b { "111" } else { "000" };
+        let mut enabled = 0;
+        let mut native_controls = 0;
+        for group in rows.chunks_exact(5) {
+            for row in group {
+                assert_eq!(row.len(), 14);
+                assert_eq!(row[0], group[0][0]);
+            }
+            let fast: u32 = group[0][4].parse().unwrap();
+            if fast == 0 {
+                native_controls += 5;
+                continue;
+            }
+            enabled += 5;
+            let kind = match group[0][2] {
+                "reliable" => ReliabilityType::Reliable,
+                "rexmit" => ReliabilityType::Rexmit,
+                "timed" => ReliabilityType::Timed,
+                _ => panic!("source kind"),
+            };
+            let value: u32 = group[0][3].parse().unwrap();
+            let initial = Instant::now();
+            let later = initial + Duration::from_secs(7200);
+            let mut a = assoc(0, fast, 0);
+            source_stream_queue(&mut a, kind, value, 3000);
+            let message_id = a.outbound_queue.peek_pending().unwrap().message_id;
+            let mut last_sent = vec![0, 0, 0];
+            let mut last_effective = String::new();
+            let mut last_raw = false;
+            let mut last_all = false;
+            for row in group {
+                let packets = match row[1] {
+                    "original-first" | "original-middle" | "original-last" => {
+                        let ch = a.send_next_data_chunk(initial).unwrap();
+                        assert!((1..=3).contains(&ch.tsn));
+                        vec![]
+                    }
+                    "fast" => {
+                        for tsn in 1..=3 {
+                            a.outbound_queue.get_mut(tsn).unwrap().miss_indicator = 3;
+                        }
+                        a.will_retransmit_fast = true;
+                        a.gather_outbound_fast_retransmission_packets(vec![], later)
+                    }
+                    "rto" if rto => {
+                        a.cwnd = 20000;
+                        a.rwnd = 20000;
+                        a.outbound_queue.mark_all_to_retransmit();
+                        a.get_data_packets_to_retransmit(later)
+                            .into_iter()
+                            .map(|packet| packet.marshal().unwrap())
+                            .collect()
+                    }
+                    "sack" => {
+                        source_ack_all(&mut a, later + Duration::from_millis(1));
+                        vec![]
+                    }
+                    _ => panic!("source stage"),
+                };
+                if row[1] != "sack" {
+                    last_sent = (1..=3)
+                        .map(|tsn| a.outbound_queue.get(tsn).map_or(0, |c| c.nsent))
+                        .collect();
+                    last_raw = a.source_pr_abandoned.contains(&message_id);
+                    last_all = a.outbound_queue.pending_len() == 0;
+                    // All source fragments share the original head. Pending
+                    // fragments have the same effective/raw flag as sent ones.
+                    last_effective = (1..=3)
+                        .map(|tsn| {
+                            if a.outbound_queue.get(tsn).is_some_and(|c| c.abandoned) {
+                                '1'
+                            } else {
+                                '0'
+                            }
+                        })
+                        .collect();
+                }
+                // After SACK the observer retains the last chunk snapshots,
+                // exactly as Go's original pointer-cohort outlives queue pop.
+                // Live queue/buffer/debt below must independently be zero.
+                assert_eq!(last_sent, parse(row[5]), "{} {} nSent", row[0], row[1]);
+                assert_eq!(
+                    last_effective, row[6],
+                    "{} {} effective head",
+                    row[0], row[1]
+                );
+                assert_eq!(bitvec(last_raw), row[7], "{} {} raw head", row[0], row[1]);
+                assert_eq!(
+                    bitvec(last_all),
+                    row[8],
+                    "{} {} all inflight",
+                    row[0],
+                    row[1]
+                );
+                assert_eq!(
+                    a.streams.get(&0).unwrap().buffered_amount,
+                    row[9].parse::<usize>().unwrap(),
+                    "{} {} actual stream buffer",
+                    row[0],
+                    row[1]
+                );
+                assert_eq!(
+                    a.outbound_queue.inflight_bytes(),
+                    row[10].parse::<usize>().unwrap(),
+                    "{} {} flight bytes",
+                    row[0],
+                    row[1]
+                );
+                assert_eq!(
+                    a.outbound_queue.pending_len(),
+                    row[11].parse::<usize>().unwrap(),
+                    "{} {} actual pending",
+                    row[0],
+                    row[1]
+                );
+                assert_eq!(
+                    packets.iter().map(|p| p.len() as u32).collect::<Vec<_>>(),
+                    parse(row[12]),
+                    "{} {} wire lengths",
+                    row[0],
+                    row[1]
+                );
+                assert_eq!(
+                    source_wire_tsns(&packets),
+                    parse(row[13]),
+                    "{} {} actual DATA TSNs",
+                    row[0],
+                    row[1]
+                );
+            }
+        }
+        assert_eq!((enabled, native_controls), (30, 30));
+    }
+    fn policy_selection(a: &mut Association, selector: &str, now: Instant) -> Vec<Bytes> {
+        match selector {
+            "fast" => {
+                a.outbound_queue.get_mut(1).unwrap().miss_indicator = 3;
+                a.will_retransmit_fast = true;
+                a.gather_outbound_fast_retransmission_packets(vec![], now)
+            }
+            "rto" => {
+                a.set_cwnd(20000);
+                a.rwnd = 20000;
+                a.outbound_queue.mark_all_to_retransmit();
+                a.get_data_packets_to_retransmit(now)
+                    .into_iter()
+                    .map(|p| p.marshal().unwrap())
+                    .collect()
+            }
+            _ => panic!("source selector"),
+        }
+    }
