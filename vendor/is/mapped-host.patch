+// A mapped host's base is an actual selected local interface, not a signaled
+// candidate address. Fixed Pion permits IPv4 link-local interfaces to be
+// rewritten to a valid public host. Keep advertised validation independent;
+// wildcard, multicast and broadcast are not physical connection identities.
+fn is_valid_physical_base(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v) => !v.is_broadcast() && !v.is_multicast() && !v.is_unspecified(),
+        IpAddr::V6(v) => !v.is_multicast() && !v.is_unspecified(),
+    }
+}
