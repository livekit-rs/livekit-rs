+    /// Actual nominated transport and whether its remote candidate is TURN.
+    /// A peer-reflexive candidate at a signaled relay's IP/protocol is TURN too,
+    /// matching fixed ICEConnectionDetails (TURN port may differ).
+    pub fn nominated_transport(&self) -> Option<(Protocol, bool)> {
+        let pair = self.nominated_pair()?;
+        let remote = pair.remote_candidate(&self.remote_candidates);
+        let relayed = remote.kind() == CandidateKind::Relayed
+            || (remote.kind() == CandidateKind::PeerReflexive
+                && self.remote_candidates.iter().any(|candidate| {
+                    candidate.kind() == CandidateKind::Relayed
+                        && candidate.addr().ip() == remote.addr().ip()
+                        && candidate.proto() == remote.proto()
+                }));
+        Some((remote.proto(), relayed))
+    }
