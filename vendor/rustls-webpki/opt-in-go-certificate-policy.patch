+    /// Go-compatible end-entity role policy. A CA:TRUE leaf is permitted only
+    /// if every ordinary chain/signature/time/EKU/name-constraint check passes.
+    /// This does not change issuer CA requirements or any default verifier.
+    #[allow(clippy::too_many_arguments)]
+    pub fn verify_for_usage_allowing_ca_end_entity<'p>(
+        &'p self,
+        supported_sig_algs: &[&dyn SignatureVerificationAlgorithm],
+        trust_anchors: &'p [TrustAnchor<'_>],
+        intermediate_certs: &'p [CertificateDer<'p>],
+        time: UnixTime,
+        usage: impl ExtendedKeyUsageValidator,
+        revocation: Option<RevocationOptions<'_>>,
+        verify_path: Option<&dyn Fn(&VerifiedPath<'_>) -> Result<(), Error>>,
+    ) -> Result<VerifiedPath<'p>, Error> {
+        verify_cert::ChainOptions {
+            eku: usage,
+            supported_sig_algs,
+            trust_anchors,
+            intermediate_certs,
+            revocation,
+            distrusted_spkis: verify_cert::DISTRUSTED_SPKIS,
+            allow_ca_end_entity: true,
         }
         .build_chain(self, time, verify_path)
     }
