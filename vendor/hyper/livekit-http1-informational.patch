+    #[cfg(feature = "server")]
+    pub(crate) fn write_informational(&mut self, response: http::Response<()>) {
+        let status = response.status();
+        // As with a normal final response, an explicit 100 replaces the
+        // automatic 100 that would otherwise accompany the first body read.
+        if status == http::StatusCode::CONTINUE {
+            if let Reading::Continue(decoder) = &self.state.reading {
+                self.state.reading = Reading::Body(decoder.clone());
+            }
+        }
+
+        let out = self.io.headers_buf();
+        out.extend_from_slice(if self.state.version == Version::HTTP_10 {
+            b"HTTP/1.0 "
+        } else {
+            b"HTTP/1.1 "
+        });
+        out.extend_from_slice(status.as_str().as_bytes());
+        out.push(b' ');
+        if let Some(reason) = status.canonical_reason() {
+            out.extend_from_slice(reason.as_bytes());
+        } else {
+            out.extend_from_slice(b"status code ");
+            out.extend_from_slice(status.as_str().as_bytes());
+        }
+        out.extend_from_slice(b"\r\n");
+        for (name, value) in response.headers() {
+            if name == http::header::CONTENT_LENGTH || name == http::header::TRANSFER_ENCODING {
+                continue;
+            }
+            out.extend_from_slice(name.as_str().as_bytes());
+            out.extend_from_slice(b": ");
+            out.extend_from_slice(value.as_bytes());
+            out.extend_from_slice(b"\r\n");
+        }
+        out.extend_from_slice(b"\r\n");
+    }
